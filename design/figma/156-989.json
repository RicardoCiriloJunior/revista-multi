xt-[#67786b] text-[11px] text-center top-[80px] w-[42px]\" data-node-id=\"202:752\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          4%\n        </p>\n        <div className=\"absolute bg-[#c9cdbb] h-[220px] left-[1005px] top-[100px] w-px\" data-node-id=\"202:753\" data-name=\"Grade vertical 6\" />\n        <p className=\"-translate-x-1/2 [word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[13px] left-[1006px] text-[#67786b] text-[11px] text-center top-[80px] w-[42px]\" data-node-id=\"202:754\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          6%\n        </p>\n        <div className=\"absolute bg-[#c9cdbb] h-[220px] left-[1265px] top-[100px] w-px\" data-node-id=\"202:755\" data-name=\"Grade vertical 8\" />\n        <p className=\"-translate-x-1/2 [word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[13px] left-[1266px] text-[#67786b] text-[11px] text-center top-[80px] w-[42px]\" data-node-id=\"202:756\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          8%\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Archivo:Bold'] font-bold h-[60px] leading-[20px] left-0 text-[#ad6c49] text-[16px] text-left top-[107px] w-[190px]\" data-node-id=\"202:757\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          Norte\n        </p>\n        <div className=\"absolute bg-[#ad6c49] h-[26px] left-[225px] rounded-[3px] top-[104px] w-[819px]\" data-node-id=\"202:758\" data-name=\"Barra Norte\" />\n        <p className=\"[word-break:break-word] absolute font-['Archivo:SemiBold'] font-semibold leading-[18px] left-[1053px] text-[#153b2e] text-[14px] text-left top-[106px] w-[64px]\" data-node-id=\"202:759\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          6,3%\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[20px] left-0 text-[#153b2e] text-[16px] text-left top-[151px] w-[190px]\" data-node-id=\"202:760\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          Nordeste\n        </p>\n        <div className=\"absolute bg-[#153b2e] h-[26px] left-[225px] rounded-[3px] top-[148px] w-[624px]\" data-node-id=\"202:761\" data-name=\"Barra Nordeste\" />\n        <p className=\"[word-break:break-word] absolute font-['Archivo:SemiBold'] font-semibold leading-[18px] left-[858px] text-[#153b2e] text-[14px] text-left top-[150px] w-[64px]\" data-node-id=\"202:762\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          4,8%\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[20px] left-0 text-[#153b2e] text-[16px] text-left top-[195px] w-[190px]\" data-node-id=\"202:763\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          Centro-Oeste\n        </p>\n        <div className=\"absolute bg-[#153b2e] h-[26px] left-[225px] rounded-[3px] top-[192px] w-[364px]\" data-node-id=\"202:764\" data-name=\"Barra Centro-Oeste\" />\n        <p className=\"[word-break:break-word] absolute font-['Archivo:SemiBold'] font-semibold leading-[18px] left-[598px] text-[#153b2e] text-[14px] text-left top-[194px] w-[64px]\" data-node-id=\"202:765\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          2,8%\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[20px] left-0 text-[#153b2e] text-[16px] text-left top-[239px] w-[190px]\" data-node-id=\"202:766\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          Sudeste\n        </p>\n        <div className=\"absolute bg-[#153b2e] h-[26px] left-[225px] rounded-[3px] top-[236px] w-[299px]\" data-node-id=\"202:767\" data-name=\"Barra Sudeste\" />\n        <p className=\"[word-break:break-word] absolute font-['Archivo:SemiBold'] font-semibold leading-[18px] left-[533px] text-[#153b2e] text-[14px] text-left top-[238px] w-[64px]\" data-node-id=\"202:768\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          2,3%\n        </p>\n        <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[20px] left-0 text-[#153b2e] text-[16px] text-left top-[283px] w-[190px]\" data-node-id=\"202:769\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          Sul\n        </p>\n        <div className=\"absolute bg-[#153b2e] h-[26px] left-[225px] rounded-[3px] top-[280px] w-[221px]\" data-node-id=\"202:770\" data-name=\"Barra Sul\" />\n        <p className=\"[word-break:break-word] absolute font-['Archivo:SemiBold'] font-semibold leading-[18px] left-[455px] text-[#153b2e] text-[14px] text-left top-[282px] w-[64px]\" data-node-id=\"202:771\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          1,7%\n        </p>\n      </div>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[0] left-[48px] text-[#153b2e] text-[0px] text-left top-[674px] w-[648px]\" data-node-id=\"202:772\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        <span className=\"font-['Libre_Baskerville:Regular'] leading-[52px] text-[52px]\">E</span>\n        <span className=\"leading-[27px] text-[18px]\">m 2024, 6,3% dos domicílios do Norte estavam em insegurança grave, ante 1,7% no Sul — cerca de 3,7 vezes a taxa sulista. Entre as demais regiões, o Nordeste marcou 4,8%, o Centro-Oeste 2,8% e o Sudeste 2,3%. A diferença revela uma desigualdade territorial na intensidade da privação.</span>\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[0] left-[744px] text-[#153b2e] text-[0px] text-left top-[674px] w-[648px]\" data-node-id=\"202:773\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        <span className=\"font-['Libre_Baskerville:Regular'] leading-[52px] text-[52px]\">N</span>\n        <span className=\"leading-[27px] text-[18px]\">o mesmo ano, 37,7% dos domicílios do Norte enfrentavam algum grau de insegurança, contra 24,2% no Brasil. A média nacional esconde prevalências regionais distintas. O gráfico mostra a distribuição, mas não identifica as causas da desigualdade nem permite atribuir a variação a um fator isolado.</span>\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[19px] left-[48px] text-[#67786b] text-[15px] text-left top-[942px] w-[1344px]\" data-node-id=\"202:774\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        Fonte: IBGE, PNAD Contínua — Segurança Alimentar 2024. Indicador: percentual de domicílios em insegurança alimentar grave por região.\n      </p>\n    </a>\n  );\n}",
