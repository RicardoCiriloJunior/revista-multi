    "const assetPathPrefix = \"https://www.figma.com/api/mcp/asset/1866bbac-7154-42b1-aba0-9cae3f402ffa\";\nconst img09InsegurancaAlimentarGravePorRegiao = `${assetPathPrefix}/e6ce3.svg`;\n\nexport default function Component09InsegurancaAlimentarGravePorRegiao() {\n  return (\n    <a className=\"block cursor-pointer relative size-full\" data-node-id=\"156:989\" data-name=\"09 • Insegurança alimentar grave por região\">\n      <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={img09InsegurancaAlimentarGravePorRegiao} />\n      <div className=\"absolute contents inset-[3.91%_77.99%_94.43%_3.33%]\" data-node-id=\"156:991\" data-name=\"Rubrica\">\n        <p className=\"[word-break:break-word] absolute font-['Archivo:Bold'] font-bold inset-[3.91%_77.99%_94.43%_3.33%] leading-[normal] text-[#ad6c49] text-[16px] text-left whitespace-nowrap\" data-node-id=\"156:992\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          DESIGUALDADE REGIONAL / 2024\n        </p>\n      </div>\n      <p className=\"[word-break:break-word] absolute font-['Libre_Baskerville:Regular'] font-normal inset-[7.81%_3.33%_86.52%_3.33%] leading-[58px] text-[#153b2e] text-[48px] text-left\" data-node-id=\"156:993\">\n        Insegurança alimentar grave por região\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal inset-[15.23%_3.33%_81.45%_3.33%] leading-[33.6px] text-[#153b2e] text-[24px] text-left\" data-node-id=\"156:994\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        Em 2024, a proporção no Norte foi quase quatro vezes a do Sul.\n      </p>\n      <div className=\"absolute h-[360px] left-[48px] top-[270px] w-[1344px]\" data-node-id=\"202:743\" data-name=\"Figura 2 • Insegurança grave por região\">\n        <p className=\"[word-break:break-word] absolute font-['Archivo:Bold'] font-bold h-[60px] leading-[15px] left-0 text-[#ad6c49] text-[12px] text-left top-0 w-[1344px]\" data-node-id=\"202:744\" styl