67786b)] top-[477.7px] w-[326px]\" data-node-id=\"265:751\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        <p className=\"leading-[17px]\">Algum grau de insegurança</p>\n      </div>\n    </div>\n  );\n}\n\nexport default function Component08EvolucaoDaInsegurancaAlimentar() {\n  return (\n    <a className=\"block cursor-pointer relative size-full\" data-node-id=\"156:979\" data-name=\"08 • Evolução da insegurança alimentar\">\n      <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={img08EvolucaoDaInsegurancaAlimentar} />\n      <div className=\"absolute contents inset-[3.91%_75.49%_94.43%_3.33%]\" data-node-id=\"156:981\" data-name=\"Rubrica\">\n        <p className=\"[word-break:break-word] absolute font-['Archivo:Bold'] font-bold inset-[3.91%_75.49%_94.43%_3.33%] leading-[normal] text-[#ad6c49] text-[16px] text-left whitespace-nowrap\" data-node-id=\"156:982\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          LEVANTAMENTOS / BRASIL 2004–2024\n        </p>\n      </div>\n      <p className=\"[word-break:break-word] absolute font-['Libre_Baskerville:Regular'] font-normal inset-[7.81%_3.33%_86.52%_3.33%] leading-[58px] text-[#153b2e] text-[48px] text-left\" data-node-id=\"156:983\">\n        Evolução da insegurança alimentar\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal inset-[15.23%_3.33%_81.45%_3.33%] leading-[33.6px] text-[#153b2e] text-[24px] text-left\" data-node-id=\"156:984\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        Os levantamentos mostram avanço e retrocesso; as diferenças de método pedem cautela na comparação.\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[60px] leading-[19px] left-[48px] text-[#67786b] text-[15px] text-left top-[942px] w-[1344px]\" data-node-id=\"201:879\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        Fontes: IBGE, PNAD/POF e PNAD Contínua (2004–2024); Rede PENSSAN, I e II VIGISAN (2020; 2021–22). Em 2024, os níveis arredondados somam 24,1%, enquanto o total publicado é 24,2%; a diferença de 0,1 p.p. decorre do arredondamento. Os inquéritos têm métodos distintos; compare os períodos com cautela.\n      </p>\n      <AnaliseGraficaEvolucaoDaInsegurancaAlimentar className=\"absolute h-[530px] left-[48px] top-[254px] w-[1344px]\" />\n      <div className=\"-translate-y-1/2 [word-break:break-word] absolute flex flex-col font-['Archivo:Bold'] font-bold h-[18px] justify-center leading-[0] left-[48px] text-[12px] text-[color:var(----cor-terracota,#ad6c49)] text-left top-[813px] w-[1344px]\" data-node-id=\"268:751\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        <p className=\"leading-[15px]\">LEITURA CRÍTICA</p>\n      </div>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[92px] leading-[20px] left-[48px] text-[15px] text-[color:var(--margem-cor-verde,#153b2e)] text-left top-[826px] w-[1344px]\" data-node-id=\"268:752\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        Algum grau de insegurança chegou a 55,2% em 2020 e 58,7% em 2021–22, superando a parcela segura. Em 2024, recuou a 24,2%, com 75,8% dos domicílios em segurança. A insegurança grave foi 9,0% e 15,5% nos levantamentos da pandemia e 3,2% em 2024. A melhora nacional não descreve igualmente todos os territórios nem a trajetória de cada família. IBGE e VIGISAN têm métodos distintos; esses pontos não formam uma série anual homogênea nem permitem atribuir causas.\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Bold'] font-bold leading-[14px] left-[62px] text-[#ad6c49] text-[11.5px] text-left top-[195px] w-[1328px]\" data-node-id=\"298:866\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        FAO E ACESSO DOMICILIAR\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal h-[38px] leading-[16px] left-[62px] text-[#153b2e] text-[13px] text-left top-[211px] w-[1328px]\" data-node-id=\"298:867\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        A FAO mede a subalimentação na população; os gráficos mostram o acesso à alimentação nos domicílios. O Brasil voltou ao Mapa no triênio 2019–2021 e permaneceu fora em 2022–2024 e 2023–2025. Sair do Mapa não significa que a fome acabou.\n      </p>\n      <div className=\"absolute bg-[#ad6c49] h-[50px] left-[48px] top-[196px] w-[3px]\" data-node-id=\"298:868\" data-name=\"FAO • filete\" />\n    </a>\n  );\n}",
