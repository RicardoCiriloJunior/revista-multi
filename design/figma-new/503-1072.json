    "const assetPathPrefix = \"https://www.figma.com/api/mcp/asset/7dbefcb7-d5dd-4c89-9dee-fa8dc412b723\";\nconst img18DepoimentosSobreAInsegurancaAlimentar = `${assetPathPrefix}/e6ce3.svg`;\n\ntype EditorialCarrosselDeCitacoesProps = {\n  className?: string;\n  voz?: \"Mariazinha Baré\";\n};\n\nfunction EditorialCarrosselDeCitacoes({ className, voz = \"Mariazinha Baré\" }: EditorialCarrosselDeCitacoesProps) {\n  return (\n    <div className={className || \"bg-[var(--margem-cor-verde,#153b2e)] content-stretch flex flex-col gap-[8px] h-[283px] items-start px-[24px] py-[16px] relative rounded-[8px] w-[1344px]\"} data-node-id=\"50:141\">\n      <p className=\"[word-break:break-word] font-['Archivo:Bold'] font-bold leading-[24px] relative shrink-0 text-[16px] text-[color:var(--margem-cor-lima,#d5e74e)] w-[1296px]\" data-node-id=\"50:142\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        VOZES DA PESQUISA / ENTREVISTAS PUBLICADAS\n      </p>\n      <p className=\"[word-break:break-word] font-['Libre_Baskerville:Regular'] font-normal leading-[43px] relative shrink-0 text-[32px] text-[color:var(--margem-cor-papel,#f2efdf)] w-[1296px]\" data-node-id=\"50:143\">\n        “A navegabilidade melhorou em algumas regiões, mas a questão da insegurança alimentar e a falta de água potável permanecem.”\n      </p>\n      <p className=\"[word-break:break-word] font-['Archivo:Bold'] font-bold leading-[24px] relative shrink-0 text-[16px] text-[color:var(--margem-cor-lima,#d5e74e)] w-[1296px]\" data-node-id=\"50:144\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        MARIAZINHA BARÉ • APIAM\n      </p>\n      <p className=\"[word-break:break-word] font-['Archivo:Regular'] font-normal leading-[24px] relative shrink-0 text-[16px] text-[color:var(--margem-cor-papel,#f2efdf)] w-[1296px]\" data-node-id=\"50:145\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        Entrevista publicada por Murilo Pajolla / Brasil de Fato, 19/01/2024.\n      </p>\n      <div className=\"content-stretch flex gap-[16px] h-[36px] items-start overflow-clip relative shrink-0 w-[1296px]\" data-node-id=\"50:146\" data-name=\"Escolha da citação\">\n        <div className=\"bg-[var(--margem-cor-lima,#d5e74e)] border border-[var(--margem-cor-lima,#d5e74e)] border-solid content-stretch flex h-[36px] items-center justify-center overflow-clip p-[6px] relative rounded-[18px] shrink-0 w-[272px]\" data-node-id=\"50:147\" data-name=\"Ler Mariazinha Baré\">\n          <p className=\"[word-break:break-word] font-['Archivo:Bold'] font-bold leading-[24px] relative shrink-0 text-[16px] text-[color:var(--margem-cor-verde,#153b2e)] w-[240px]\" data-node-id=\"50:148\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n            01 / Mariazinha Baré\n          </p>\n        </div>\n        <button className=\"bg-[var(--margem-cor-verde,#153b2e)] border border-[var(--margem-cor-lima,#d5e74e)] border-solid content-stretch cursor-pointer flex h-[36px] items-center justify-center overflow-clip p-[6px] relative rounded-[18px] shrink-0 w-[272px]\" data-node-id=\"50:149\" data-name=\"Ler Neideana Ribeiro\">\n          <div className=\"[word-break:break-word] font-['Archivo:Bold'] font-bold leading-[0] relative shrink-0 text-[16px] text-[color:var(--margem-cor-papel,#f2efdf)] text-left w-[240px]\" data-node-id=\"50:150\" role=\"button\" style={{ fontVariationSettings: '\"wdth\" 100' }} tabIndex=\"0\">\n            <p className=\"leading-[24px]\">02 / Neideana Ribeiro</p>\n          </div>\n        </button>\n      </div>\n    </div>\n  );\n}\n\nexport default function Component18DepoimentosSobreAInsegurancaAlimentar() {\n  return (\n    <button className=\"block cursor-pointer relative size-full\" data-node-id=\"503:1072\" data-name=\"18 • Depoimentos sobre a insegurança alimentar\">\n      <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={img18DepoimentosSobreAInsegurancaAlimentar} />\n      <div className=\"absolute contents inset-[3.91%_82.15%_94.43%_3.33%]\" data-node-id=\"661:597\" data-name=\"Rubrica\">\n        <p className=\"[word-break:break-word] absolute font-['Archivo:Bold'] font-bold inset-[3.91%_82.15%_94.43%_3.33%] leading-[normal] text-[#ad6c49] text-[16px] text-left whitespace-nowrap\" data-node-id=\"661:598\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          ENTREVISTAS / CITAÇÕES\n        </p>\n      </div>\n      <p className=\"[word-break:break-word] absolute font-['Libre_Baskerville:Regular'] font-normal inset-[7.81%_3.33%_86.52%_3.33%] leading-[58px] text-[#153b2e] text-[48px] text-left\" data-node-id=\"661:599\">\n        Depoimentos sobre a insegurança alimentar\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal inset-[15.23%_3.33%_81.45%_3.33%] leading-[33.6px] text-[#153b2e] text-[24px] text-left\" data-node-id=\"661:600\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        Relatos publicados ajudam a compreender o que as estatísticas não contam sozinhas.\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal inset-[88.87%_38.75%_6.74%_3.33%] leading-[22.4px] text-[#67786b] text-[16px] text-left\" data-node-id=\"661:601\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        Fontes das falas: Mariazinha Baré / Murilo Pajolla, Brasil de Fato, 19 jan. 2024; Neideana Ribeiro / Jhonny Lima, A Crítica, 5 out. 2025. Referências completas na p. 22.\n      </p>\n      <div className=\"[word-break:break-word] absolute border border-[var(--margem-cor-linha,#c9cdbb)] border-solid content-stretch flex gap-[24px] h-[76px] items-start leading-[24px] left-[48px] p-[12px] rounded-[4px] text-[16px] text-left top-[212px]\" data-node-id=\"661:602\" data-name=\"Mini glossário • nesta página\">\n        <p className=\"font-['Archivo:Bold'] font-bold relative shrink-0 text-[color:var(----cor-terracota,#ad6c49)] w-[140px]\" data-node-id=\"I661:602;50:97\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          GLOSSÁRIO\n        </p>\n        <p className=\"font-['Archivo:Regular'] font-normal relative shrink-0 text-[color:var(--margem-cor-verde,#153b2e)] w-[1156px]\" data-node-id=\"I661:602;50:98\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          APIAM • Articulação das Organizações e Povos Indígenas do Amazonas. Rede PENSSAN • Rede Brasileira de Pesquisa em Soberania e Segurança Alimentar e Nutricional.\n        </p>\n      </div>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Bold'] font-bold leading-[24px] left-[72px] text-[16px] text-[color:var(----cor-terracota,#ad6c49)] text-left top-[461px] w-[1296px]\" data-node-id=\"661:605\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        MARIAZINHA BARÉ • APIAM\n      </p>\n      <p className=\"[word-break:break-word] absolute font-['Archivo:Regular'] font-normal leading-[24px] left-[72px] text-[16px] text-[color:var(--margem-cor-papel,#f2efdf)] text-left top-[491px] w-[1296px]\" data-node-id=\"661:606\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n        Entrevista publicada por Murilo Pajolla / Brasil de Fato, 19/01/2024.\n      </p>\n      <div className=\"absolute content-stretch flex gap-[16px] h-[36px] items-start left-[72px] overflow-clip top-[529px] w-[1296px]\" data-node-id=\"661:607\" data-name=\"Escolha da citação\">\n        <div className=\"bg-[var(----cor-terracota,#ad6c49)] border border-[var(----cor-terracota,#ad6c49)] border-solid content-stretch flex h-[36px] items-center justify-center overflow-clip p-[6px] relative rounded-[18px] shrink-0 w-[272px]\" data-node-id=\"661:608\" data-name=\"Ler Mariazinha Baré\">\n          <p className=\"[word-break:break-word] font-['Archivo:Bold'] font-bold leading-[24px] relative shrink-0 text-[16px] text-[color:var(--margem-cor-verde,#153b2e)] text-left w-[240px]\" data-node-id=\"661:609\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n            01 / Mariazinha Baré\n          </p>\n        </div>\n        <div className=\"bg-[var(--margem-cor-verde,#153b2e)] border border-[var(----cor-terracota,#ad6c49)] border-solid content-stretch flex h-[36px] items-center justify-center overflow-clip p-[6px] relative rounded-[18px] shrink-0 w-[272px]\" data-node-id=\"661:610\" data-name=\"Ler Ana Maria Segall\">\n          <p className=\"[word-break:break-word] font-['Archivo:Bold'] font-bold leading-[24px] relative shrink-0 text-[16px] text-[color:var(--margem-cor-papel,#f2efdf)] text-left w-[240px]\" data-node-id=\"661:611\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n            02 / Neideana Ribeiro\n          </p>\n        </div>\n      </div>\n      <div className=\"[word-break:break-word] absolute bg-[#f3f0e6] border border-[#c4c9ba] border-solid content-stretch flex flex-col gap-[7px] h-[266px] items-start left-[48px] overflow-clip px-[18px] py-[14px] rounded-[8px] text-left top-[620px] w-[648px]\" data-node-id=\"661:612\" data-name=\"Relato • Mariazinha Baré\">\n        <p className=\"font-['Archivo:Bold'] font-bold leading-[20px] relative shrink-0 text-[#ad6c49] text-[12px] w-[610px]\" data-node-id=\"661:613\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          RELATO • LÁBREA (AM), 2024\n        </p>\n        <div className=\"content-stretch flex flex-col gap-[60px] items-start relative shrink-0\" data-node-id=\"661:614\">\n          <div className=\"content-stretch flex flex-col gap-[25px] items-start leading-[20px] relative shrink-0 text-[#153b2e]\" data-node-id=\"661:615\">\n            <p className=\"font-['Archivo:Bold'] font-bold relative shrink-0 text-[32px] w-[610px]\" data-node-id=\"661:616\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n              A água voltou, mas a comida não\n            </p>\n            <p className=\"font-['Archivo:Regular'] font-normal relative shrink-0 text-[20px] w-[610px]\" data-node-id=\"661:617\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n              Depois da seca de 2023, a melhora da navegabilidade não significou a retomada da segurança alimentar nem do acesso à água potável. Mariazinha Baré relata perdas nas roças e falta de macaxeira, feijão e peixe — alimentos básicos que também sustentam a renda local.\n            </p>\n          </div>\n          <p className=\"font-['Archivo:Regular'] font-normal leading-[normal] relative shrink-0 text-[#66786b] text-[12px] w-[610px]\" data-node-id=\"661:618\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n            Murilo Pajolla, Brasil de Fato, 19 jan. 2024. Relato publicado em reportagem.\n          </p>\n        </div>\n      </div>\n      <EditorialCarrosselDeCitacoes className=\"absolute bg-[var(--margem-cor-verde,#153b2e)] content-stretch flex flex-col gap-[8px] h-[283px] items-start left-[48px] px-[24px] py-[16px] rounded-[8px] top-[312px] w-[1344px]\" />\n      <div className=\"[word-break:break-word] absolute bg-[#f3f0e6] border border-[#c4c9ba] border-solid content-stretch flex flex-col gap-[7px] h-[266px] items-start left-[744px] overflow-clip px-[18px] py-[14px] rounded-[8px] text-left top-[620px] w-[648px]\" data-node-id=\"661:629\" data-name=\"Relato • Neideana Ribeiro e UNICEF\">\n        <p className=\"font-['Archivo:Bold'] font-bold leading-[20px] relative shrink-0 text-[#ad6c49] text-[12px] w-[610px]\" data-node-id=\"661:630\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n          ENTREVISTA + DADO COLETIVO • AMAZÔNIA\n        </p>\n        <div className=\"content-stretch flex flex-col gap-[60px] items-start relative shrink-0\" data-node-id=\"661:631\">\n          <div className=\"content-stretch flex flex-col gap-[25px] items-start leading-[20px] relative shrink-0 text-[#153b2e]\" data-node-id=\"661:632\">\n            <p className=\"font-['Archivo:Bold'] font-bold relative shrink-0 text-[32px] w-[610px]\" data-node-id=\"661:633\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n              Quando o rio é a única estrada\n            </p>\n            <p className=\"font-['Archivo:Regular'] font-normal relative shrink-0 text-[20px] w-[610px]\" data-node-id=\"661:634\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n              Neideana Ribeiro, especialista do UNICEF em Manaus, destaca o papel dos rios no deslocamento e no abastecimento do interior. Em entrevista sobre as secas de 2023 e 2024, descreve comunidades isoladas quando a navegação se torna inviável.\n            </p>\n          </div>\n          <p className=\"font-['Archivo:Regular'] font-normal leading-[normal] relative shrink-0 text-[#66786b] text-[12px] w-[610px]\" data-node-id=\"661:635\" style={{ fontVariationSettings: '\"wdth\" 100' }}>\n            Jhonny Lima. “Fome: ‘Norte é uma região ainda muito vulnerável’.” A Crítica, 5 out. 2025. Referência completa na p. 22.\n          </p>\n        </div>\n      </div>\n    </button>\n  );\n}",
